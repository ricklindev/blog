---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<aside class="callout" aria-label={title ?? 'Note'} role="note">
  {title && <p class="callout-title">{title}</p>}
  <div class="callout-content"><slot /></div>
</aside>

<style>
  .callout {
    border-block: 1px solid var(--line, currentColor);
    margin-block: 2rem;
    padding: 1rem 0;
  }

  .callout-title {
    font: 600 0.6875rem/1.4 var(--sans, system-ui, sans-serif);
    letter-spacing: 0.08em;
    margin: 0 0 0.5rem;
    text-transform: uppercase;
  }
  .callout-content :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
