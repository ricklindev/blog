---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<aside class="callout" aria-label={title ?? 'Note'} role="note">
  {title && <p class="callout-title">{title}</p>}
  <div class="callout-content"><slot /></div>
</aside>

<style>
  .callout {
    border-block: 1px solid currentColor;
    margin-block: 2rem;
    padding-block: 1rem;
  }

  .callout-title {
    font: 600 0.75rem/1.4 system-ui, sans-serif;
    letter-spacing: 0.08em;
    margin: 0 0 0.5rem;
    text-transform: uppercase;
  }
</style>
