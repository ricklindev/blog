---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { isLocalSiteUrl, localSiteUrl, site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  cover?: ImageMetadata;
  publishedAt?: Date;
  updatedAt?: Date;
  draft?: boolean;
}

const {
  title = site.title,
  description = site.description,
  canonicalPath = Astro.url.pathname,
  type = 'website',
  cover,
  publishedAt,
  updatedAt,
  draft = false
} = Astro.props;
const configuredSiteUrl = Astro.site ?? localSiteUrl;
const normalizedPath = canonicalPath === '/' || canonicalPath.endsWith('/')
  ? canonicalPath
  : `${canonicalPath}/`;
const canonicalUrl = new URL(normalizedPath, configuredSiteUrl);
const socialImage = cover
  ? await getImage({ src: cover, width: 1200, format: 'jpg' })
  : { src: '/og-default.png' };
const imageUrl = new URL(socialImage.src, configuredSiteUrl);
const noindex = draft || isLocalSiteUrl(configuredSiteUrl);
---

<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl.href} />
<link rel="alternate" type="application/rss+xml" title={site.title} href={new URL('/rss.xml', configuredSiteUrl).href} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.author} />
<meta property="og:url" content={canonicalUrl.href} />
<meta property="og:image" content={imageUrl.href} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl.href} />
{type === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{type === 'article' && updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
