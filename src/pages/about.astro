---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
---

<Layout title={`About — ${site.author}`} description={`About ${site.author}'s independent writing on technology, products, work, learning, and life.`}>
  <article class="about-page">
    <p class="page-label">About</p>
    <h1>A place to keep thinking in public.</h1>
    <div class="about-copy">
      <p>This is an independent publication for notes on technology, products, engineering, work, learning, and the parts of life that shape how we make things.</p>
      <p>The aim is not to arrive at a polished answer every time. It is to leave a clear record of the questions, observations, and revisions that are useful to return to.</p>
      <p>Writing is organized as a small, ongoing practice: fewer categories, more attention to the work underneath them.</p>
    </div>
  </article>
</Layout>
